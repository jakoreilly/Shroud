<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Shroud.Ui.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="Shroud.Ui.Views.IdentityView"
             x:DataType="vm:IdentityViewModel">

  <Grid RowDefinitions="Auto,*">

    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
      <TextBlock Classes="h2" Text="Identity" />
      <TextBlock Classes="explainer"
                 Text="Your identity is one key pair that does two jobs: people encrypt files to it, and you sign files with it. It lives in this folder and never leaves this machine." />
    </StackPanel>

    <Grid Grid.Row="1">

      <StackPanel Classes="empty" MaxWidth="360" Spacing="10"
                  IsVisible="{Binding !HasIdentity}" IsEnabled="{Binding !IsCreating}">
        <TextBlock Classes="h2" Text="You don't have an identity yet" HorizontalAlignment="Center" />
        <TextBlock Classes="explainer" HorizontalAlignment="Center"
                   Text="Creating one takes a few seconds. You'll choose a passphrase that protects the key file on disk." />
        <TextBox Watermark="New passphrase" PasswordChar="•" Text="{Binding NewPassphrase, Mode=TwoWay}" />
        <TextBox Watermark="Confirm passphrase" PasswordChar="•" Text="{Binding ConfirmPassphrase, Mode=TwoWay}" />
        <Button Classes="primary" Content="Create my identity" Command="{Binding CreateIdentityCommand}"
                HorizontalAlignment="Center" />
        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" HorizontalAlignment="Center"
                    Foreground="{DynamicResource BannerBadBorder}"
                    IsVisible="{Binding ErrorMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>

      <StackPanel Spacing="12" IsVisible="{Binding HasIdentity}">
        <Border Classes="banner caution" IsVisible="{Binding ShowBackupBanner}">
          <StackPanel Spacing="8">
            <TextBlock TextWrapping="Wrap"
                       Text="Back up identity.key now. If you lose this file or forget its passphrase, everything encrypted to you becomes unreadable. There is no recovery and no reset." />
            <Button Classes="quiet" Content="I've backed it up" Command="{Binding AcknowledgeBackupCommand}" />
          </StackPanel>
        </Border>

        <StackPanel Spacing="4">
          <TextBlock Classes="explainer" TextWrapping="Wrap"
                     Text="Your fingerprint -- read this to people out loud so they can confirm the key they received from you is really yours." />
          <SelectableTextBlock Classes="fingerprint" Text="{Binding Fingerprint}" FontSize="20" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="quiet" Content="Copy fingerprint" Command="{Binding CopyFingerprintCommand}" />
            <TextBlock Text="{Binding CopyFeedback}" VerticalAlignment="Center" Opacity="0.75" />
          </StackPanel>
        </StackPanel>
      </StackPanel>

      <Grid Classes="busy" IsVisible="{Binding IsCreating}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
          <ProgressBar IsIndeterminate="True" Width="220" />
          <TextBlock Text="Generating your identity…" HorizontalAlignment="Center" />
        </StackPanel>
      </Grid>

    </Grid>
  </Grid>

</UserControl>
